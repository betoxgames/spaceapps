{
  "name": "space-papers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/domain.test.ts tests/clock.test.ts",
    "test:audio": "node tests/audio-browser.mjs",
    "test:audio-offline": "node tests/audio-offline-browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:dispatch": "node tests/dispatch-browser.mjs",
    "test:manual": "node tests/manual-browser.mjs",
    "test:manual-actions": "node tests/manual-actions-browser.mjs",
    "test:reports": "node tests/report-browser.mjs",
    "test:desk": "node tests/desk-browser.mjs",
    "test:stamps": "node tests/stamps-browser.mjs",
    "test:desk-layout": "node tests/desk-layout-browser.mjs",
    "test:camera": "node tests/camera-browser.mjs",
    "test:training": "node tests/training-browser.mjs",
    "test:characters": "node tests/characters-browser.mjs",
    "test:offline": "node tests/offline-browser.mjs",
    "test:visitors": "node tests/visitor-browser.mjs",
    "test:ux": "node tests/ux-browser.mjs",
    "test:accessibility": "node tests/desk-accessibility-browser.mjs",
    "release:package": "pnpm build && node scripts/package-release.mjs",
    "test:distribution": "node tests/distribution.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
